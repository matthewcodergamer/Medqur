PORT=8080
DATABASE_URL=postgres://medqur:medqur@localhost:5432/medqur

# Production authentication: configure an OIDC issuer/JWKS and audience.
MEDQUR_OIDC_ISSUER=https://identity.example.gov.jm/
MEDQUR_OIDC_AUDIENCE=medqur-api
MEDQUR_OIDC_JWKS_URL=https://identity.example.gov.jm/.well-known/jwks.json

# Development only. Never enable on an internet-facing deployment.
MEDQUR_DEV_AUTH=false

# Ed25519 PEM keys used to sign offline medication-catalog releases.
MEDQUR_CATALOG_SIGNING_PRIVATE_KEY_PEM=
MEDQUR_CATALOG_SIGNING_KEY_ID=medqur-catalog-v1

# Optional FHIR destination. Export remains local unless explicitly configured.
MEDQUR_FHIR_BASE_URL=
